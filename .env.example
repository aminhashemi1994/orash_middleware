# Orash Scan — service configuration.
# Copy to .env and edit. Real environment variables override these.

# ---------------------------------------------------------------- networking

# Interface to bind. Use 127.0.0.1 when nginx (or any reverse proxy) sits in
# front, so the service cannot be reached directly from the network.
# Use 0.0.0.0 to serve a LAN directly with no proxy.
HOST=127.0.0.1
PORT=4173

# The address users type in the browser. REQUIRED when HOST=127.0.0.1:
# the phone pairing QR points here, and the loopback address is meaningless
# to a phone. No trailing slash.
PUBLIC_URL=https://qr.tooscore.ir

# nginx terminates TLS, so the built-in HTTPS listener is not needed.
# Set to 1 (or remove) only when serving a LAN directly with no proxy.
HTTPS=0
HTTPS_PORT=4443

# Supply your own certificate instead of the generated self-signed one.
# Only relevant when HTTPS is enabled.
# TLS_KEY=/etc/ssl/private/panel.key
# TLS_CERT=/etc/ssl/certs/panel.crt

# ------------------------------------------------------------------- upstream

# The Orash AutomationAPI host the panel talks to. Users can still change this
# in the UI; this is only the pre-filled default.
ORASH_BASE_URL=http://192.168.3.210:5000

# Give up on an unresponsive Orash host after this many milliseconds.
UPSTREAM_TIMEOUT_MS=20000

# ------------------------------------------------------------------- safety

# 1 = answer everything from the built-in simulator; nothing reaches Orash.
# Useful for demos and for testing while the API host is down.
MOCK=0

# 1 = allow CreateGood / CreateInvoice against the PRODUCTION database.
# Leave at 0 unless you mean it.
ALLOW_PROD_WRITE=0
